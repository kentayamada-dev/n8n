.json.workflowNamesInN8N));\n\nconst githubNames = githubItem?.json.workflowNamesInGitHub ?? [];\nconst n8nNames = n8nItem?.json.workflowNamesInN8N ?? [];\n\nconst normalize = (v) => v.trim().replace(/\\.json$/i, \"\");\n\nconst n8nSet = new Set(n8nNames.map(normalize).filter(Boolean));\n\nconst githubOnlyNames = githubNames.filter((gh) => {\n  const key = normalize(gh);\n  return key && !n8nSet.has(key);\n});\n\nreturn githubOnlyNames.map((name) => ({json: {name}}));"}},{"type":"n8n-nodes-base.github","typeVersion":1.1,"position":[0,96],"id":"8606e6b9-6ad3-45da-8cc3-079196052efb","name":"GitHubにあるワークフローを取得","webhookId":"c4ac5eee-b635-4961-9c23-f8b47aa99de4","credentials":{"githubApi":{"id":"CfSYyQB4QcHIEzny","name":"GitHub account"}},"parameters":{"resource":"file","operation":"list","owner":{"__rl":true,"value":"https://github.com/kentayamada-dev","mode":"url"},"repository":{"__rl":true,"value":"n8n","mode":"list","cachedResultName":"n8n","cachedResultUrl":"https://github.com/kentayamada-dev/n8n"},"filePath":"workflows"}}],"connections":{"手動実行":{"main":[[{"node":"N8Nにあるワークフローを取得","type":"main","index":0},{"node":"GitHubにあるワークフローを取得","type":"main","index":0}]]},"ループ":{"main":[[],[{"node":"ワークフローファイルを取得","type":"main","index":0}]]},"作成用データを整形":{"main":[[{"node":"ワークフローを作成","type":"main","index":0}]]},"ワークフローを作成":{"main":[[{"node":"ループ","type":"main","index":0}],[{"node":"ループ","type":"main","index":0}]]},"ワークフローファイルを取得":{"main":[[{"node":"JSONデータに変換","type":"main","index":0}],[{"node":"ループ","type":"main","index":0}]]},"JSONデータに変換":{"main":[[{"node":"作成用データを整形","type":"main","index":0}],[{"node":"ループ","type":"main","index":0}]]},"N8Nにあるワークフローを取得":{"main":[[{"node":"N8Nにあるワークフローをまとめる","type":"main","index":0}]]},"GitHubにあるワークフローをまとめる":{"main":[[{"node":"マージ","type":"main","index":0}]]},"N8Nにあるワークフローをまとめる":{"main":[[{"node":"マージ","type":"main","index":1}]]},"マージ":{"main":[[{"node":"N8Nに追加するワークフロー","type":"main","index":0}]]},"N8Nに追加するワークフロー":{"main":[[{"node":"ループ","typ