    {
      "parameters": {
        "jsCode": "// GitHubに無くなったリポジトリのバックアップ（Drive上のファイル）を削除対象にする\nconst normalize = (v) =>\n  String(v ?? \"\").trim().replace(/\\.zip$/i, \"\").toLowerCase();\n\nconst repoNames = new Set(\n  $(\"全てのレポジトリ取得\").all()\n    .map((i) => normalize(i.json.name))\n    .filter(Boolean),\n);\n\n// 安全装置: GitHub側のリポジトリが1件も取れていない場合は\n// (トークン失効・API障害などの可能性があるため) 何も削除しない\nif (repoNames.size === 0) {\n  return [];\n}\n\n// Driveのフォルダが空のときは Always Output Data で空のアイテムが来るので、IDのないものは除く\nreturn $input.all()\n  .map((i) => i.json)\n  .filter((f) => {\n    const key = normalize(f.name);\n    return f.id && key && !repoNames.has(key);\n  })\n  .map((f) => ({ json: { name: f.name, id: f.id } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
