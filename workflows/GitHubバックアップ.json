    {
      "parameters": {
        "jsCode": "// 「レポジトリダウンロード」で失敗したリポジトリをまとめて、ワークフローをエラーで止める。\n// エラーで止めると「エラー通知」ワークフローが Slack に知らせる（以前はエラー出力がどこにもつながっておらず、黙って抜け落ちていた）。\n//\n// 注意: このノードはキャンバス上で「レポジトリが存在している」より下に置くこと。\n// 実行順序 v1 では上にある分岐から先に動くので、下に置けば成功したリポジトリのアップロードが全部終わってから止まる。\n// 上に置くと先にここで止まり、その日は1件もアップロードされない。\nconst MAX_LINES = 10;\n\nconst lines = $input.all().map((item, i) => {\n  // エラー出力のアイテムには元の入力（owner / name）と error が入っている。\n  // 入っていなければ、ペアになっている「バックアップ対象リスト」の行から取る\n  let repo = item.json ?? {};\n  if (!repo.name) {\n    try {\n      repo = $('バックアップ対象リスト').itemMatching(i).json;\n    } catch (e) {\n      // 対応する行が見つからないときは名前不明のまま報告する\n    }\n  }\n  const err = item.json?.error ?? {};\n  const reason = typeof err === 'string'\n    ? err\n    : (err.message || err.description || JSON.stringify(err));\n  const status = typeof err === 'object' ? (err.httpCode ?? err.status ?? err.statusCode ?? '') : '';\n  const name = repo.name ? `${repo.owner ? `${repo.owner}/` : ''}${repo.name}` : '(リポジトリ名不明)';\n  return `${name}${status ? ` [${status}]` : ''}: ${String(reason).slice(0, 80)}`;\n});\n\nif (lines.length === 0) return [];\n\nthrow new Error(\n  `${lines.length}件のリポジトリをダウンロードできず、バックアップしていません。\\n`\n  + lines.slice(0, MAX_LINES).map((s) => `・${s}`).join('\\n')\n  + (lines.length > MAX_LINES ? `\\n他 ${lines.length - MAX_LINES}件` : ''),\n);\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
