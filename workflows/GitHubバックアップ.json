    {
      "parameters": {
        "jsCode": "// GitHubのリポジトリごとに、Drive上の既存バックアップのファイルIDを紐付ける\nconst normalize = (v) =>\n  String(v ?? \"\").trim().replace(/\\.zip$/i, \"\").toLowerCase();\n\n// Driveの既存バックアップを「リポジトリ名(小文字) → ファイルID」で索引化\n// (Driveのフォルダが空のときは Always Output Data で空のアイテムが来るので、IDのないものは除く)\nconst driveIdByName = new Map();\nfor (const { json: f } of $input.all()) {\n  const key = normalize(f.name);\n  if (f.id && key && !driveIdByName.has(key)) {\n    driveIdByName.set(key, f.id);\n  }\n}\n\nreturn $(\"全てのレポジトリ取得\").all()\n  .map((i) => i.json)\n  .filter((r) => r.name && r.owner?.login)\n  .map((r) => ({\n    json: {\n      owner: r.owner.login,\n      name: r.name,\n      driveFileId: driveIdByName.get(normalize(r.name)) ?? null,\n    },\n  }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        192
      ],
