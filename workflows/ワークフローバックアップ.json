    {
      "parameters": {
        "jsCode": "// GitHubにあって、n8nに無くなったワークフローのファイルを削除対象にする\nconst normalize = (v) => v.trim().replace(/\\.json$/i, \"\");\n\nconst n8nWorkflows = $input.all().map((i) => i.json);\n\n// 安全装置: n8nから取れた一覧に、このワークフロー自身が入っていなければ何も削除せずに止める。\n// 一覧が空、またはAPIキーの持ち主・プロジェクトが違って一部しか見えていないと、GitHubのファイルを全部消してしまうため。\n// 正しく動いていればこの状態にはならないので、黙って飛ばさずにエラーにして「エラー通知」でSlackに知らせる\n// （このノードはバックアップより上にあり先に動くので、ここで止まるとその日のバックアップも行われない）\nif (!n8nWorkflows.some((w) => w.id === $workflow.id)) {\n  throw new Error(\n    `n8nから取得したワークフロー一覧（${n8nWorkflows.length}件）に、このワークフロー自身が含まれていません。`\n    + \"認証情報「n8n account」のAPIキーの持ち主とプロジェクトを確認してください。GitHubのファイルは削除していません。\",\n  );\n}\n\nconst n8nNames = new Set(\n  n8nWorkflows\n    .map((w) => w.name)\n    .filter(Boolean)\n    .map(normalize)\n    .filter(Boolean),\n);\n\n// GitHubのフォルダが空のときは Always Output Data で空のアイテムが来るので、名前のないものは除く\nreturn $(\"GitHubにあるワークフローを取得\").all()\n  .map((i) => i.json.name)\n  .filter((name) => name && normalize(name) && !n8nNames.has(normalize(name)))\n  .map((name) => ({ json: { name } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1824,
        464
      ],
      "id": "b1a33923-fd66-4080-9911-acaf9f845da8",
      "name": "削除するワークフロー"
