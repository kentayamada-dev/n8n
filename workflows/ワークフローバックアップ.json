    {
      "parameters": {
        "jsCode": "// GraphQL は失敗しても HTTP 200 で errors を返すので、HTTP Request ノードはエラーにならない\n// 黙って抜け落ちないよう、ここでエラーにして「エラー通知」で Slack に知らせる\n// expectedHeadOid には「ブランチの先頭を取得」の sha を渡している。途中でブランチが進んでいたら GitHub が拒否し、ここで止まる（次の実行でやり直す）\nconst res = $input.first().json;\nconst commit = res.data?.createCommitOnBranch?.commit;\n\nif (res.errors?.length || !commit) {\n  const reason = (res.errors ?? []).map((e) => e.message).join(' / ') || JSON.stringify(res).slice(0, 300);\n  throw new Error(`ブランチにコミットできませんでした: ${reason}`);\n}\n\nreturn [{ json: commit }];\n"
      },
