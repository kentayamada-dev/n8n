    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// コミットに入れる、追加・更新するファイル\n// 中身は base64 のまま渡す（createCommitOnBranch も base64 で受け取る）\nconst name = $('N8Nにあるワークフローを取得').item.json.name;\n\nreturn {\n  json: {\n    name,\n    path: `workflows/${name}.json`,\n    contents: $('base64に変換').item.json.data,\n    // 「GitHubのファイルを取得」で見つからず、エラーのまま続けたときは sha が無い = 新しいファイル\n    action: $json.sha ? 'update' : 'add',\n  },\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2688,
        560
      ],
      "id": "1baa6c5e-3974-4d6e-b989-1679cb7a292d",
      "name": "追加・更新するファイル"
    },
    {
      "parameters": {
        "jsCode": "// 削除と、追加・更新するファイルを、1 つのコミットの中身にまとめる\n// 一番下の枝なので、上の 2 つの枝（削除するワークフロー・追加・更新するファイル）が終わってから動く\n// 変更が無かった枝のノードは動かないので、動いたものだけ読む\nconst read = (name) => ($(name).isExecuted ? $(name).all().map((i) => i.json) : []);\n\nconst upserts = read('追加・更新するファイル');\nconst deletes = read('削除するワークフロー');\n\nconst changes = [\n  ...upserts.map((f) => ({ action: f.action, name: f.name })),\n  ...deletes.map((f) => ({ action: 'delete', name: f.name.replace(/\\.json$/i, '') })),\n];\n\n// 変更が無ければコミットも PR も作らない\nif (changes.length === 0) {\n  return [];\n}\n\n// 1 件なら今までと同じ「update: 支出記録」。複数なら見出しは「update: 支出記録 ほか 2 件」にして、本文に 1 件ずつ並べる\nconst lines = changes.map((c) => `${c.action}: ${c.name}`);\nconst actions = new Set(changes.map((c) => c.action));\nconst prefix = actions.size === 1 ? changes[0].action : 'update';\nconst message = changes.length === 1\n  ? { headline: lines[0] }\n  : { headline: `${prefix}: ${changes[0].name} ほか ${changes.length - 1} 件`, body: lines.join('\\n') };\n\nconst fileChanges = {};\nif (upserts.length > 0) {\n  fileChanges.additions = upserts.map((f) => ({ path: f.path, contents: f.contents }));\n}\nif (deletes.length > 0) {\n  fileChanges.deletions = deletes.map((f) => ({ path: `workflows/${f.name}` }));\n}\n\nreturn [{ json: { message, fileChanges } }];\n"
      },
